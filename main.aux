\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces All orientations of \smash  {\colorbox {colorF!50}{F}}, \smash  {\colorbox {colorV!50}{V}}, \smash  {\colorbox {colorW!50}{W}}, \smash  {\colorbox {colorZ!50}{Z}}, \smash  {\colorbox {colorP!50}{P}}, and \smash  {\colorbox {colorT!50}{T}}{} in a $3 \times n$ after reducing by symmetry. The following satisfy \cref  {th: Sided removal}: \smash  {\colorbox {colorV!50}{V}}, \smash  {\colorbox {colorW!50}{W}}, \smash  {\colorbox {colorZ!50}{Z}}, the second \smash  {\colorbox {colorP!50}{P}}{} and \smash  {\colorbox {colorT!50}{T}}{}, and the left side of both \smash  {\colorbox {colorF!50}{F}}'s. Additionally, the second \smash  {\colorbox {colorF!50}{F}}{} is strictly worse than the first \smash  {\colorbox {colorF!50}{F}}, since after filling in the ignorable subgrid, the first \smash  {\colorbox {colorF!50}{F}}{} practically replaces a wall with an empty square when compared to the second \smash  {\colorbox {colorF!50}{F}}. (A red border denotes \cref  {th: Sided removal} is satisfied for the given side).}}{26}{figure.25}\protected@file@percent }
\newlabel{fig:Reduced orientations}{{25}{26}{All orientations of \pentF , \pentV , \pentW , \pentZ , \pentP , and \pentT {} in a $3 \times n$ after reducing by symmetry. The following satisfy \cref {th: Sided removal}: \pentV , \pentW , \pentZ , the second \pentP {} and \pentT {}, and the left side of both \pentF 's. Additionally, the second \pentF {} is strictly worse than the first \pentF , since after filling in the ignorable subgrid, the first \pentF {} practically replaces a wall with an empty square when compared to the second \pentF . (A red border denotes \cref {th: Sided removal} is satisfied for the given side)}{figure.25}{}}
